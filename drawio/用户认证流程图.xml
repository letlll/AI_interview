<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="draw.io" version="26.2.2">
  <diagram name="用户认证流程" id="auth-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ========== 泳道(底层) ========== -->
        <mxCell id="lane-backend" value="后端 (Django + DRF)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#82b366;strokeWidth=1;dashed=1;fontSize=10;fontColor=#82b366;verticalAlign=top;align=left;spacingLeft=8;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="720" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="lane-frontend" value="前端 (Vue3 + Pinia + axios)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;fontSize=10;fontColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=8;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="720" height="500" as="geometry"/>
        </mxCell>

        <!-- ========== 开始/结束 ========== -->
        <mxCell id="start" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="30" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="920" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="end-fail" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="240" width="80" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== 后端区域：认证流程 ========== -->
        <mxCell id="step1" value="用户输入邮箱+密码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step2" value="后端验证凭据（django-allauth）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="165" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="judge1" value="验证通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="235" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="step3" value="签发 JWT Token Pair&lt;br&gt;Access 2h + Refresh 7d" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="325" width="200" height="45" as="geometry"/>
        </mxCell>

        <!-- ========== 前后端交接 ========== -->
        <mxCell id="step3b" value="返回 Token 给前端" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="400" width="200" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== 前端区域 ========== -->
        <mxCell id="step4" value="存储至 Pinia auth store" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="470" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="step5" value="axios 拦截器自动附加&lt;br&gt;Authorization: Bearer &lt;token&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="545" width="240" height="45" as="geometry"/>
        </mxCell>

        <!-- ========== 后端区域：Token 验证 ========== -->
        <mxCell id="step6" value="后端 JWTAuthentication&lt;br&gt;中间件解密验证 Token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="630" width="220" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="step7" value="返回业务数据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="740" width="180" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== 失败分支 (右侧) ========== -->
        <mxCell id="fail-step" value="返回 401 错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="245" width="120" height="40" as="geometry"/>
        </mxCell>

        <!-- ========== Token 过期分支 (左侧) ========== -->
        <mxCell id="expire-judge" value="Token 过期？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="550" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="expire-step1" value="axios 响应拦截器&lt;br&gt;捕获 401" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="expire-step2" value="调用 /auth/token/refresh/&lt;br&gt;获取新 Access Token" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="715" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="expire-step3" value="重试原请求（用户无感知）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="790" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="end-expire-fail" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="75" y="870" width="70" height="35" as="geometry"/>
        </mxCell>

        <!-- ==================== 连接线 ==================== -->

        <!-- 主流程线 -->
        <mxCell id="e-start-s1" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="start" target="step1"/>
        <mxCell id="e-s1-s2" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="step1" target="step2"/>
        <mxCell id="e-s2-j1" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="step2" target="judge1"/>

        <!-- 验证通过 → 是 → 向下 -->
        <mxCell id="e-j1-yes" value="是" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontStyle=1;fontColor=#009900;" edge="1" parent="1" source="judge1" target="step3"/>

        <!-- 验证未通过 → 否 → 向右 -->
        <mxCell id="e-j1-no" value="否" style="endArrow=block;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=11;fontStyle=1;fontColor=#cc0000;" edge="1" parent="1" source="judge1" target="fail-step"/>
        <mxCell id="e-fail-end" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="fail-step" target="end-fail"/>

        <!-- 签发JWT → 返回Token给前端 -->
        <mxCell id="e-s3-s3b" value="HTTP Response" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="step3" target="step3b"/>

        <!-- 返回Token → 前端存储 -->
        <mxCell id="e-s3b-s4" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="step3b" target="step4"/>

        <!-- 存储 → 请求携带Token -->
        <mxCell id="e-s4-s5" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="step4" target="step5"/>

        <!-- 请求 → 后端验证Token -->
        <mxCell id="e-s5-s6" value="API 请求" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontColor=#6c8ebf;fontStyle=2;" edge="1" parent="1" source="step5" target="step6"/>

        <!-- Token有效 → 返回数据 -->
        <mxCell id="e-s6-s7" value="Token 有效" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontColor=#009900;" edge="1" parent="1" source="step6" target="step7"/>
        <mxCell id="e-s7-end" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="step7" target="end"/>

        <!-- ========== Token 过期分支: step6 返回 401 → 左侧 expire 流程 ========== -->
        <mxCell id="e-s6-expire" value="401 Unauthorized" style="endArrow=block;html=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontColor=#cc0000;fontStyle=1;" edge="1" parent="1" source="step6" target="expire-judge"/>

        <!-- expire-judge 是 → 进入刷新流程 -->
        <mxCell id="e-expJ-yes" value="是" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;" edge="1" parent="1" source="expire-judge" target="expire-step1"/>
        <mxCell id="e-exp1-exp2" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="expire-step1" target="expire-step2"/>
        <mxCell id="e-exp2-exp3" style="endArrow=block;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="expire-step2" target="expire-step3"/>

        <!-- 重试 → 回到 step5 重新发送请求 -->
        <mxCell id="e-exp3-s5" value="重新请求" style="endArrow=block;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=9;fontStyle=2;" edge="1" parent="1" source="expire-step3" target="step5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- expire-judge 否 → Token未过期但收到401，非预期错误，直接结束 -->
        <mxCell id="e-expJ-no" value="否" style="endArrow=block;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;edgeStyle=orthogonalEdgeStyle;rounded=1;fontSize=10;fontStyle=1;fontColor=#cc0000;" edge="1" parent="1" source="expire-judge" target="end-expire-fail">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
