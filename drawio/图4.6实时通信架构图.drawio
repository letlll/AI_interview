        </mxCell>
        <mxCell id="r46-ws-e3b" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r46-ws-3b" target="r46-ws-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r46-ws-4" value="④ Consumer.disconnect()&lt;br&gt;group_discard 离开房间组，释放 Redis 订阅与连接" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
