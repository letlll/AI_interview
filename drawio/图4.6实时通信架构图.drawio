          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r46-ws-3b" value="③b chat_message 分支：消息持久化至数据库&lt;br&gt;→ group_send 广播至房间内所有连接" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
