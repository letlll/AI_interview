<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/26.2.2 Chrome/134.0.6998.178 Electron/35.1.2 Safari/537.36" version="26.2.2">
  <diagram name="图4.6 实时通信架构图" id="fig46-real-time-comm">
    <mxGraphModel dx="1583" dy="1089" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 主标题 ===== -->
        <mxCell id="r46-title" value="图4.6 实时通信架构图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="263" y="10" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- ===== 中间分隔虚线 ===== -->
        <mxCell id="r46-divider" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="413" y="55" as="sourcePoint" />
            <mxPoint x="413" y="600" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ==================== SSE 左侧列 ==================== -->

        <!-- SSE 列标题 -->
        <mxCell id="r46-sse-header" value="SSE（Server-Sent Events）— 面试追问推送" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="360" height="35" as="geometry" />
        </mxCell>

        <!-- SSE 步骤1 -->
        <mxCell id="r46-sse-1" value="① 前端 fetch API 发起 POST 请求" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="115" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- SSE 边 1→2 -->
        <mxCell id="r46-sse-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-sse-1" target="r46-sse-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSE 步骤2 -->
        <mxCell id="r46-sse-2" value="② POST /api/v1/interviews/{id}/submit-answer-stream/" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- SSE 边 2→3 -->
        <mxCell id="r46-sse-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-sse-2" target="r46-sse-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSE 步骤3 -->
        <mxCell id="r46-sse-3" value="③ 后端 DRF 视图创建 StreamingHttpResponse&lt;br&gt;（content_type: text/plain）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="245" width="320" height="45" as="geometry" />
        </mxCell>

        <!-- SSE 边 3→4 -->
        <mxCell id="r46-sse-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-sse-3" target="r46-sse-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSE 步骤4 -->
        <mxCell id="r46-sse-4" value="④ Python Generator 逐块 yield AI 追问文本" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- SSE 边 4→5 -->
        <mxCell id="r46-sse-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-sse-4" target="r46-sse-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSE 步骤5 -->
        <mxCell id="r46-sse-5" value="⑤ 前端读取响应体流，逐字渲染追加显示" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- SSE 边 5→6 -->
        <mxCell id="r46-sse-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-sse-5" target="r46-sse-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- SSE 步骤6（数据库） -->
        <mxCell id="r46-sse-6" value="⑥ 追问文本持久化至 InterviewQuestion 表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fontSize=10;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="445" width="280" height="50" as="geometry" />
        </mxCell>

        <!-- SSE 标注 -->
        <mxCell id="r46-sse-anno" value="单向推送 ｜ HTTP 协议 ｜ 流式传输（ chunked ）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="320" height="32" as="geometry" />
        </mxCell>

        <!-- ==================== WebSocket 右侧列 ==================== -->

        <!-- WS 列标题 -->
        <mxCell id="r46-ws-header" value="WebSocket — AI 简历对话" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="427" y="60" width="360" height="35" as="geometry" />
        </mxCell>

        <!-- WS 步骤1 -->
        <mxCell id="r46-ws-1" value="① 前端 new WebSocket('ws://host/ws/chat/{user_id}/')" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="447" y="115" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- WS 边 1→2 -->
        <mxCell id="r46-ws-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-ws-1" target="r46-ws-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WS 步骤2 -->
        <mxCell id="r46-ws-2" value="② Django Channels 路由层分发至 ChatConsumer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="447" y="180" width="320" height="40" as="geometry" />
        </mxCell>

        <!-- WS 边 2→3 -->
        <mxCell id="r46-ws-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-ws-2" target="r46-ws-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WS 步骤3 -->
        <mxCell id="r46-ws-3" value="③ Consumer.connect()&lt;br&gt;JWT Token 认证 + 加入 Redis Channel Layer 房间组" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="447" y="245" width="320" height="48" as="geometry" />
        </mxCell>

        <!-- WS 边 3→4 -->
        <mxCell id="r46-ws-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-ws-3" target="r46-ws-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WS 步骤4 -->
        <mxCell id="r46-ws-4" value="④ Consumer.receive() 消息类型分支处理" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="447" y="318" width="320" height="38" as="geometry" />
        </mxCell>

        <!-- WS 边 4→5 -->
        <mxCell id="r46-ws-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-ws-4" target="r46-ws-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WS 步骤5（消息分支详情） -->
        <mxCell id="r46-ws-5" value="chat_message → 持久化至 DB + group_send 广播&lt;br&gt;typing_indicator → 转发"正在输入"状态&lt;br&gt;read_messages → 批量更新消息已读状态" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="447" y="381" width="320" height="52" as="geometry" />
        </mxCell>

        <!-- WS 边 5→6 -->
        <mxCell id="r46-ws-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="r46-ws-5" target="r46-ws-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- WS 步骤6 -->
        <mxCell id="r46-ws-6" value="⑤ Consumer.disconnect()&lt;br&gt;group_discard 离开房间组，释放连接" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="447" y="458" width="320" height="48" as="geometry" />
        </mxCell>

        <!-- WS 标注 -->
        <mxCell id="r46-ws-anno" value="双向全双工 ｜ 持久连接 ｜ WebSocket 协议" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="447" y="530" width="320" height="32" as="geometry" />
        </mxCell>

        <!-- ==================== Redis Channel Layer 底部共享区域 ==================== -->

        <!-- Redis 区域背景 -->
        <mxCell id="r46-redis-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#d6b656;strokeWidth=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="627" height="210" as="geometry" />
        </mxCell>

        <!-- Redis 标题 -->
        <mxCell id="r46-redis-header" value="Redis Channel Layer（跨进程通信基础设施）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="213" y="608" width="400" height="28" as="geometry" />
        </mxCell>

        <!-- Redis 进程 A -->
        <mxCell id="r46-redis-pa" value="&lt;b&gt;Django 进程 A&lt;/b&gt;&lt;br&gt;收到消息 → publish 至 Redis 房间组" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="125" y="655" width="185" height="55" as="geometry" />
        </mxCell>

        <!-- Redis 边 PA → Center -->
        <mxCell id="r46-redis-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="r46-redis-pa" target="r46-redis-center">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redis 中心 -->
        <mxCell id="r46-redis-center" value="&lt;b&gt;Redis Pub/Sub&lt;/b&gt;&lt;br&gt;group_add → group_send&lt;br&gt;→ broadcast 至同组所有连接" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="195" height="65" as="geometry" />
        </mxCell>

        <!-- Redis 边 Center → PB -->
        <mxCell id="r46-redis-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=2;strokeColor=#d6b656;" edge="1" parent="1" source="r46-redis-center" target="r46-redis-pb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Redis 进程 B -->
        <mxCell id="r46-redis-pb" value="&lt;b&gt;Django 进程 B&lt;/b&gt;&lt;br&gt;subscribe 接收 → 推送至对应 WebSocket 客户端" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="565" y="655" width="185" height="55" as="geometry" />
        </mxCell>

        <!-- Redis 底部注释 -->
        <mxCell id="r46-redis-note" value="多个 Django 进程通过 Redis Pub/Sub 实现跨进程消息路由——连接在不同进程上的用户可互通消息" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;fontColor=#888888;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="155" y="735" width="517" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== WebSocket ↔ Redis 连接线 ==================== -->

        <!-- WS connect → Redis：从 WS Box3 右侧引出，进入 Redis 背景区域 -->
        <mxCell id="r46-ws2redis-1" value="group_add" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;fontSize=8;fontColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="r46-ws-3" target="r46-redis-center">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="607" y="320" />
              <mxPoint x="607" y="590" />
              <mxPoint x="437" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- WS receive → Redis：从 WS Box5 右侧引出，进入 Redis -->
        <mxCell id="r46-ws2redis-2" value="group_send" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;dashed=1;strokeColor=#d79b00;fontSize=8;fontColor=#d79b00;fontStyle=2;" edge="1" parent="1" source="r46-ws-5" target="r46-redis-center">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="607" y="460" />
              <mxPoint x="607" y="590" />
              <mxPoint x="398" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Redis → WS disconnect：从 Redis 回连到 WS Box6 -->
        <mxCell id="r46-redis2ws-1" value="broadcast 断开通知" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;fontSize=8;fontColor=#b85450;fontStyle=2;" edge="1" parent="1" source="r46-redis-center" target="r46-ws-6">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="437" y="730" />
              <mxPoint x="607" y="730" />
              <mxPoint x="607" y="530" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ==================== 两侧对比标注箭头 ==================== -->

        <!-- 左侧技术特征标注 -->
        <mxCell id="r46-label-sse-tech" value="基于标准 HTTP 协议&lt;br&gt;实现简单，代理/负载均衡兼容性好" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="565" width="320" height="35" as="geometry" />
        </mxCell>

        <!-- 右侧技术特征标注 -->
        <mxCell id="r46-label-ws-tech" value="需要 Channels + Redis 支持&lt;br&gt;适合高频双向实时交互场景" style="text;html=1;strokeColor=#82b366;fillColor=#d5e8d4;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=9;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="447" y="575" width="320" height="35" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
